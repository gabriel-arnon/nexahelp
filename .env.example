# VITE_CHAT_MODE controla somente a interface e e publico porque variaveis VITE_
# podem ser embutidas no bundle do navegador.
#   mock: usa respostas demonstrativas locais.
#   api : chama POST /api/chat, que executa exclusivamente no servidor.
VITE_CHAT_MODE=mock

# Variaveis exclusivamente server-side.
# Nao armazene chaves reais neste arquivo versionado.
# Nao use prefixo VITE_ para segredos.
OPENAI_API_KEY=<configurar-no-servidor>

# Modelo padrao usado pelo endpoint server-side. Pode ser alterado no ambiente
# do servidor sem modificar o codigo.
OPENAI_MODEL=gpt-5-mini
